# Copy this file to .env and fill in local secrets.
# The Go backend loads optional `.env` from the repo root (`../.env` when started from `backend/`)
# and does not override variables already exported in your shell.
#
# Zhihu login requires non-empty ZHIHU_APP_ID and ZHIHU_APP_KEY (see internal RFC for test keys).

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------

# Gin listen address.
SERVER_ADDRESS=:8080

# SQLite DSN. When running `make backend`, this is relative to backend/.
DB_DSN=file:data/app.db?cache=shared&mode=rwc

# JWT signing secret. Change this for any shared/staging/production deployment.
JWT_SECRET=change-me-in-production

# Timeout for OpenAI-compatible endpoint validation / arena calls.
OPENAI_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Zhihu OAuth Login
# -----------------------------------------------------------------------------

# Test app IDs from the internal RFC:
#   187: no phone/email authorization
#   188: with phone/email authorization
ZHIHU_APP_ID=300

# Do not commit real app keys. Copy the matching key from the internal RFC.
ZHIHU_APP_KEY=

# Must exactly match the redirect URI registered for the Zhihu OAuth app.
# Docker Compose：前端容器前的 Nginx 反代了 /api，可用同一主机 80 端口（不写 :8080），例如：
#   http://你的公网IP或域名/api/v1/auth/zhihu/callback
# 本地直连后端示例：
ZHIHU_REDIRECT_URI=http://localhost:8080/api/v1/auth/zhihu/callback

# Where the backend redirects after OAuth callback ticket creation.
# Compose 映射主机 80 时与浏览器地址一致，例如 http://localhost 或 http://你的公网IP（勿带端口）。
FRONTEND_ORIGIN=http://localhost

# Zhihu OpenAPI host. Usually no need to change.
ZHIHU_OPENAPI_HOST=openapi.zhihu.com

